{
  "name": "PocThermalPrinter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "clean-app": "yarn clean-npm && yarn clean-gradlew && yarn clean-pod && watchman watch-del-all",
    "clean-npm": "rm -rf node_modules/ && yarn install",
    "clean-pod": "cd ios && rm -rf Podfile.lock && RCT_NEW_ARCH_ENABLED=0 pod install && cd ..",
    "clean-gradlew": "rm -rf android/app/.cxx && cd android && ./gradlew clean && rm -rf ~/.gradle && rm -rf ~/.gradle/caches/* && cd .."
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-permissions": "^5.4.2",
    "react-native-view-shot": "^4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/eslint-config": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/typescript-config": "0.76.9",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
